# Copy to .env for local/Docker Compose. Demo values only — not for production.

POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby
POSTGRES_DB=nearby_friends
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://nearby:nearby@postgres:5432/nearby_friends
DATABASE_URL_SYNC=postgresql://nearby:nearby@postgres:5432/nearby_friends

REDIS_URL=redis://redis:6379/0

# Inactive users disappear from discovery after this TTL (seconds). Default 10 minutes.
LOCATION_TTL_SECONDS=600

# MVP cap. Production "whale" users need partitioned fan-out (see docs/scalability.md).
MAX_FRIENDS=50

DEFAULT_RADIUS_MILES=5.0
NEARBY_PAGE_SIZE=20

# Identifies this process in logs (override per replica).
INSTANCE_ID=local-1
SERVICE_NAME=unspecified

CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

DEMO_MODE=true

# Frontend (Vite build-time). In Docker these point at the compose load balancer.
VITE_API_BASE=/api
VITE_WS_URL=/ws
